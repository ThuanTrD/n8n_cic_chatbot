      },
      "id": "4750bec3-e75c-4747-ad85-2956ac78be49",
      "name": "FB - Get All Conversations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3200,
        1744
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('CONFIG - EDIT HERE').first().json;\nconst out = [];\n\nfor (const page of $input.all()) {\n  const conversations = Array.isArray(page.json?.data) ? page.json.data : [];\n\n  for (const c of conversations) {\n    const participants = Array.isArray(c.participants?.data)\n      ? c.participants.data\n      : [];\n\n    const customer = participants.find(\n      p => String(p.id || '') !== String(cfg.page_id || '')\n    );\n\n    out.push({\n      json: {\n        conversation_id: String(c.id || ''),\n        updated_time: c.updated_time || null,\n        page_id: String(cfg.page_id || ''),\n        graph_version: String(cfg.graph_version || 'v26.0'),\n        page_access_token: String(cfg.page_access_token || ''),\n        customer_psid: customer?.id ? String(customer.id) : '',\n        customer_name: customer?.name || ''\n      }\n    });\n  }\n}\n\nreturn out.filter(i => i.json.conversation_id);"
      },
      "id": "5ede55e8-6052-4357-b6ab-3d78445655a1",
      "name": "Split Conversations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3472,
        1744
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://graph.facebook.com/' + $json.graph_version + '/' + $json.conversation_id + '/messages' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,created_time,from,to,message"
            },
            {
              "name": "limit",
              "value": "100"
            },
            {
              "name": "access_token",
              "value": "={{ $json.page_access_token }}"
            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ $response.body.paging?.next || '' }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.paging?.next }}",
              "limitPagesFetched": true,
              "maxRequests": 1000,
              "requestInterval": 100
            }
          }
        }
      },
      "id": "b49e8fbb-0826-45d9-ae87-792156d77a2c",
      "name": "FB - Get All Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3744,
        1744
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('Split Conversations').item.json;\n\nreturn {\n  json: {\n    conversation_id: ctx.conversation_id,\n    page_id: ctx.page_id,\n    customer_psid: ctx.customer_psid || '',\n    customer_name: ctx.customer_name || '',\n    messages: Array.isArray($json?.data) ? $json.data : []\n  }\n};"
      },
      "id": "ec1fd61f-1148-4e53-a061-9fc697a672d0",
      "name": "Attach Conversation Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4032,
        1744
      ]
    },
    {
      "parameters": {
        "jsCode": "const pages = $input.all();\nconst byConversation = new Map();\n\nfor (const item of pages) {\n  const j = item.json;\n  const cid = String(j.conversation_id || '');\n  if (!cid) continue;\n\n  if (!byConversation.has(cid)) {\n    byConversation.set(cid, {\n      conversation_id: cid,\n      page_id: String(j.page_id || ''),\n      customer_psid: String(j.customer_psid || ''),\n      customer_name: String(j.customer_name || ''),\n      messages: []\n    });\n  }\n\n  const conv = byConversation.get(cid);\n\n  for (const m of (Array.isArray(j.messages) ? j.messages : [])) {\n    if (!m?.id) continue;\n    conv.messages.push(m);\n  }\n}\n\nconst rows = [];\n\nfor (const conv of byConversation.values()) {\n  // Deduplicate messages because pagination/retries may overlap.\n  const uniq = new Map();\n  for (const m of conv.messages) {\n    uniq.set(String(m.id), m);\n  }\n\n  const messages = [...uniq.values()]\n    .filter(m => String(m.message || '').trim())\n    .sort((a, b) => {\n      return new Date(a.created_time || 0).getTime()\n        - new Date(b.created_time || 0).getTime();\n    });\n\n  let customerName = conv.customer_name || '';\n  let questions = [];\n  let answers = [];\n\n  const flush = () => {\n    const q = questions.join('\\n').trim();\n    const a = answers.join('\\n').trim();\n\n    // Chỉ xuất cặp đã có cả câu hỏi và câu trả lời.\n    if (q && a) {\n      rows.push({\n        json: {\n          'Tên khách hàng': customerName || conv.customer_psid || 'Không xác định',\n          'Câu hỏi': q,\n          'Câu trả lời': a\n        }\n      });\n    }\n\n    questions = [];\n    answers = [];\n  };\n\n  for (const msg of messages) {\n    const senderId = String(msg.from?.id || '');\n    const text = String(msg.message || '').trim();\n    if (!text) continue;\n\n    const isPage = senderId === String(conv.page_id);\n\n    if (!isPage) {\n      if (!customerName && msg.from?.name) {\n        customerName = String(msg.from.name);\n      }\n\n      // Khách nhắn tiếp sau khi Page đã trả lời => Q&A mới.\n      if (answers.length > 0) {\n        flush();\n      }\n\n      questions.push(text);\n    } else {\n      // Bỏ qua tin Page chủ động gửi khi chưa có câu hỏi.\n      if (questions.length > 0) {\n        answers.push(text);\n      }\n    }\n  }\n\n  flush();\n}\n\nreturn rows;"
      },
