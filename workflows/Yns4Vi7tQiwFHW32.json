        "jsCode": "const input = $input.first().json;\n\nlet items = [];\n\n// Lấy text chung (chỉ dùng cho item đầu tiên)\nconst text = input.text || '';\n\nlet isFirst = true;\n\n// Lặp qua các key url1, url2, url3...\nObject.keys(input).forEach(key => {\n  if (key.startsWith('url') && input[key]) {\n    items.push({\n      json: {\n        text: isFirst ? text : '',   // <<< chỉ item đầu có text\n        image: input[key]\n      }\n    });\n    isFirst = false;\n  }\n});\n\n// Nếu không có url nào, vẫn trả 1 item có text\nif (items.length === 0) {\n  items.push({\n    json: {\n      text: text\n    }\n  });\n}\n\nreturn items;\n"
      },
